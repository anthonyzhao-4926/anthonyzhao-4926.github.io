# Jekyll 构建产物
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# 由 scripts/pull-notes.sh 生成的笔记(构建时自动生成,不入库)
_posts/notes/
assets/notes/

# 构建时临时 clone 的笔记仓库(不入库,见 .github/workflows)
_notes-src/

# 依赖
vendor/
.bundle/
node_modules/

# 本地工具配置(含本机路径,不入库)
.claude/

# 系统文件
.DS_Store
*.log
Thumbs.db

# 编辑器/IDE 本地文件
.idea/
*.swp
*~
# 注：.vscode/ 已被 git 跟踪（launch.json 为共享调试配置），如需忽略请执行:
#   git rm --cached .vscode/launch.json
